<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BusGoMobile.Pages.AccountLoadingPage"
             BackgroundColor="{StaticResource BgSurfaceContainerLowest}"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <Grid>

        <!-- ALT SİLİK YOL GÖRSELİ -->
        <Grid VerticalOptions="End" HeightRequest="300" InputTransparent="True">
            <Image Source="bus1.png"
                   Aspect="AspectFill"
                   VerticalOptions="Fill"
                   Opacity="0.5" />
            <!-- Üstten güçlü beyaz fade: görsel alta doğru hayalet gibi kalsın -->
            <BoxView>
                <BoxView.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FFFFFFFF" Offset="0.0" />
                        <GradientStop Color="#FFFFFFFF" Offset="0.45" />
                        <GradientStop Color="#CCFFFFFF" Offset="0.75" />
                        <GradientStop Color="#88FFFFFF" Offset="1.0" />
                    </LinearGradientBrush>
                </BoxView.Background>
            </BoxView>
        </Grid>

        <!-- Çok hafif üst ambient glow -->
        <Ellipse WidthRequest="260" HeightRequest="260"
                 Fill="{StaticResource BgSecondaryContainer}"
                 Opacity="0.08"
                 HorizontalOptions="Center" VerticalOptions="Start"
                 Margin="0,-80,0,0"
                 InputTransparent="True" />

        <!-- ORTA İÇERİK -->
        <VerticalStackLayout VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="0"
                             Padding="32,0">

            <!-- Marka -->
            <HorizontalStackLayout x:Name="BrandRow"
                                   Spacing="9"
                                   HorizontalOptions="Center"
                                   Opacity="0">
                <Border WidthRequest="38" HeightRequest="38"
                        StrokeShape="RoundRectangle 11"
                        BackgroundColor="{StaticResource BgSecondaryContainer}"
                        VerticalOptions="Center">
                    <Label Text="{StaticResource IconBus}"
                           FontFamily="MaterialSymbols" FontSize="21"
                           TextColor="White"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Text="BusGo"
                       FontFamily="InterExtraBold" FontSize="22"
                       TextColor="{StaticResource BgOnSurface}"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>

            <!-- Loading: dekoratif halka + spinner -->
            <Grid x:Name="LoaderArea"
                  WidthRequest="84" HeightRequest="84"
                  Margin="0,36,0,0"
                  Opacity="0">
                <Ellipse WidthRequest="84" HeightRequest="84"
                         Stroke="{StaticResource BgSurfaceContainerHigh}"
                         StrokeThickness="6"
                         Fill="Transparent" />
                <ActivityIndicator IsRunning="True"
                                   Color="{StaticResource BgSecondary}"
                                   WidthRequest="48" HeightRequest="48"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
            </Grid>

            <!-- Metinler -->
            <VerticalStackLayout x:Name="TextArea"
                                 Spacing="6"
                                 Margin="0,36,0,0"
                                 Opacity="0">
                <Label Text="Giriş yapılıyor..."
                       FontFamily="InterBold" FontSize="21"
                       TextColor="{StaticResource BgOnSurface}"
                       HorizontalTextAlignment="Center" />
                <Label Text="Hesap bilgileriniz kontrol ediliyor."
                       FontFamily="InterRegular" FontSize="13"
                       TextColor="{StaticResource BgOnSurfaceVariant}"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </VerticalStackLayout>

        <!-- Alt durum metni -->
        <HorizontalStackLayout VerticalOptions="End"
                               HorizontalOptions="Center"
                               Spacing="6"
                               Margin="0,0,0,28"
                               InputTransparent="True">
            <Label Text="{StaticResource IconVerifiedUser}"
                   FontFamily="MaterialSymbols" FontSize="13"
                   TextColor="{StaticResource BgSecondary}"
                   VerticalOptions="Center" />
            <Label Text="Güvenli giriş • BusGo"
                   FontFamily="InterMedium" FontSize="11"
                   TextColor="{StaticResource BgOnSurfaceVariant}"
                   VerticalOptions="Center" />
        </HorizontalStackLayout>
    </Grid>
</ContentPage>