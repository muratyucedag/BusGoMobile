<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:BusGoMobile.Controls"
             x:Class="BusGoMobile.Pages.HomePage"
             BackgroundColor="{StaticResource BgSurface}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ÜST BAR (Header) -->
        <Grid Grid.Row="0"
              BackgroundColor="{StaticResource BgSurface}"
              Padding="16,12"
              ColumnDefinitions="Auto,*,Auto,Auto"
              ColumnSpacing="12">

            <Border Grid.Column="0"
                    WidthRequest="32" HeightRequest="32"
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="{StaticResource BgSecondaryContainer}"
                    VerticalOptions="Center">
                <Label Text="{StaticResource IconBus}"
                       FontFamily="MaterialSymbols" FontSize="18"
                       TextColor="{StaticResource BgOnSecondary}"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0">
                <Label Text="BusGo"
                       FontFamily="InterBold" FontSize="17"
                       TextColor="{StaticResource BgOnSurface}" />
                <Label Text="Ana Sayfa"
                       FontFamily="InterRegular" FontSize="12"
                       TextColor="{StaticResource BgOnSurfaceVariant}" />
            </VerticalStackLayout>

            <!-- Bildirim (tıklanabilir) -->
            <Label Grid.Column="2"
                   Text="{StaticResource IconNotifications}"
                   FontFamily="MaterialSymbols" FontSize="22"
                   TextColor="{StaticResource BgOnSurfaceVariant}"
                   VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnNotificationsTapped" />
                </Label.GestureRecognizers>
            </Label>

            <!-- Profil (tıklanabilir) -->
            <Border Grid.Column="3"
                    WidthRequest="32" HeightRequest="32"
                    StrokeShape="RoundRectangle 16"
                    BackgroundColor="{StaticResource BgSurfaceContainerHighest}"
                    VerticalOptions="Center">
                <Label Text="{StaticResource IconPerson}"
                       FontFamily="MaterialSymbols" FontSize="18"
                       TextColor="{StaticResource BgOnSurfaceVariant}"
                       HorizontalOptions="Center" VerticalOptions="Center" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnProfileTapped" />
                </Border.GestureRecognizers>
            </Border>
        </Grid>

        <!-- KAYDIRILABİLİR İÇERİK -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,8,16,24" Spacing="20">

                <!-- Karşılama + Puan -->
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label x:Name="GreetingLabel"
                               Text=""
                               FontFamily="InterRegular" FontSize="14"
                               TextColor="{StaticResource BgOnSurfaceVariant}" />
                        <Label Text="Bugün nereye gitmek istersin?"
                               FontFamily="InterBold" FontSize="24"
                               TextColor="{StaticResource BgOnSurface}" />
                    </VerticalStackLayout>

                    <Border Grid.Column="1"
                            StrokeShape="RoundRectangle 20"
                            BackgroundColor="{StaticResource BgSurfaceContainerHigh}"
                            Padding="10,6"
                            VerticalOptions="Start">
                        <HorizontalStackLayout Spacing="4">
                            <Label Text="{StaticResource IconStar}"
                                   FontFamily="MaterialSymbols" FontSize="14"
                                   TextColor="{StaticResource BgSecondary}"
                                   VerticalOptions="Center" />
                            <Label Text="120 Puan"
                                   FontFamily="InterBold" FontSize="11"
                                   TextColor="{StaticResource BgOnSurface}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>

                <!-- Ulaşım türü sekmeleri (modern, kompakt chip) -->
                <CollectionView x:Name="CategoriesView"
                                ItemsLayout="HorizontalList"
                                HeightRequest="44">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{StaticResource BgSurfaceContainerLowest}"
                                    Stroke="{StaticResource BgOutlineVariant}"
                                    StrokeThickness="1"
                                    Padding="12,8" Margin="0,0,8,0">
                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                    <Label Text="{Binding IconGlyph}"
                                           FontFamily="MaterialSymbols" FontSize="19"
                                           TextColor="{StaticResource BgSecondary}"
                                           VerticalOptions="Center" />
                                    <Label Text="{Binding Name}"
                                           FontFamily="InterSemiBold" FontSize="13"
                                           TextColor="{StaticResource BgOnSurface}"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- KAMPANYA SLIDER (DEĞİŞTİRİLMEDİ) -->
                <VerticalStackLayout Spacing="8">
                    <Border StrokeShape="RoundRectangle 12"
                            StrokeThickness="0"
                            HeightRequest="150">
                        <Grid>
                            <Image x:Name="SlideImage"
                                   Aspect="AspectFill" />
                            <BoxView VerticalOptions="End"
                                     HeightRequest="80"
                                     Color="Black"
                                     Opacity="0.35" />
                            <VerticalStackLayout VerticalOptions="End"
                                                 Padding="14"
                                                 Spacing="2">
                                <Label x:Name="SlideTitle"
                                       FontFamily="InterBold" FontSize="17"
                                       TextColor="White" />
                                <Label x:Name="SlideSubtitle"
                                       FontFamily="InterRegular" FontSize="12"
                                       TextColor="White" />
                            </VerticalStackLayout>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSlideTapped" />
                            </Grid.GestureRecognizers>
                        </Grid>
                    </Border>

                    <HorizontalStackLayout x:Name="DotsContainer"
                                           Spacing="6"
                                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Popüler Firmalar -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="POPÜLER FİRMALAR"
                           FontFamily="InterBold" FontSize="11"
                           TextColor="{StaticResource BgOnSurfaceVariant}" />
                    <ScrollView Orientation="Horizontal"
                                HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout Spacing="8" Padding="0,0,40,0">
                            <Border StrokeShape="RoundRectangle 20"
                                    BackgroundColor="{StaticResource BgSurfaceContainerLowest}"
                                    Stroke="{StaticResource BgOutlineVariant}" StrokeThickness="1"
                                    Padding="14,7">
                                <HorizontalStackLayout Spacing="4">
                                    <Label Text="{StaticResource IconVerified}"
                                           FontFamily="MaterialSymbols" FontSize="15"
                                           TextColor="{StaticResource BgSecondary}"
                                           VerticalOptions="Center" />
                                    <Label Text="Kamil Koç" FontFamily="InterMedium" FontSize="12"
                                           TextColor="{StaticResource BgOnSurface}"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                            <Border StrokeShape="RoundRectangle 20"
                                    BackgroundColor="{StaticResource BgSurfaceContainerLowest}"
                                    Stroke="{StaticResource BgOutlineVariant}" StrokeThickness="1"
                                    Padding="14,7">
                                <HorizontalStackLayout Spacing="4">
                                    <Label Text="{StaticResource IconVerified}"
                                           FontFamily="MaterialSymbols" FontSize="15"
                                           TextColor="{StaticResource BgSecondary}"
                                           VerticalOptions="Center" />
                                    <Label Text="Pamukkale" FontFamily="InterMedium" FontSize="12"
                                           TextColor="{StaticResource BgOnSurface}"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                            <Border StrokeShape="RoundRectangle 20"
                                    BackgroundColor="{StaticResource BgSurfaceContainerLowest}"
                                    Stroke="{StaticResource BgOutlineVariant}" StrokeThickness="1"
                                    Padding="14,7">
                                <HorizontalStackLayout Spacing="4">
                                    <Label Text="{StaticResource IconVerified}"
                                           FontFamily="MaterialSymbols" FontSize="15"
                                           TextColor="{StaticResource BgSecondary}"
                                           VerticalOptions="Center" />
                                    <Label Text="Metro Turizm" FontFamily="InterMedium" FontSize="12"
                                           TextColor="{StaticResource BgOnSurface}"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                            <Border StrokeShape="RoundRectangle 20"
                                    BackgroundColor="{StaticResource BgSurfaceContainerLowest}"
                                    Stroke="{StaticResource BgOutlineVariant}" StrokeThickness="1"
                                    Padding="14,7">
                                <HorizontalStackLayout Spacing="4">
                                    <Label Text="{StaticResource IconVerified}"
                                           FontFamily="MaterialSymbols" FontSize="15"
                                           TextColor="{StaticResource BgSecondary}"
                                           VerticalOptions="Center" />
                                    <Label Text="Varan" FontFamily="InterMedium" FontSize="12"
                                           TextColor="{StaticResource BgOnSurface}"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                        </HorizontalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>

                <!-- Popüler Rotalar (CarouselView + peek + indicator) -->
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Popüler Rotalar"
                               FontFamily="InterBold" FontSize="17"
                               TextColor="{StaticResource BgOnSurface}" />
                        <Label Grid.Column="1" Text="Tümünü Gör"
                               FontFamily="InterSemiBold" FontSize="12"
                               TextColor="{StaticResource BgSecondary}"
                               VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnViewAllRoutesTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <CarouselView x:Name="PopularRoutesView"
                                  HeightRequest="150"
                                  Loop="False"
                                  PeekAreaInsets="0,0,45,0"
                                  IndicatorView="PopularRoutesIndicator">
                        <CarouselView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal"
                                               ItemSpacing="12"
                                               SnapPointsType="MandatorySingle"
                                               SnapPointsAlignment="Start" />
                        </CarouselView.ItemsLayout>
                        <CarouselView.ItemTemplate>
                            <DataTemplate>
                                <Border StrokeShape="RoundRectangle 16"
                                        StrokeThickness="0">
                                    <Grid>
                                        <Border StrokeShape="RoundRectangle 16" StrokeThickness="0">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="{Binding Color1}" Offset="0.0" />
                                                    <GradientStop Color="{Binding Color2}" Offset="1.0" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Grid Padding="16" RowDefinitions="Auto,*,Auto">
                                            <Label Grid.Row="0" Text="{Binding Route}"
                                                   FontFamily="InterBold" FontSize="16"
                                                   TextColor="White" />
                                            <Border Grid.Row="1"
                                                    StrokeShape="RoundRectangle 10"
                                                    BackgroundColor="#33FFFFFF"
                                                    Padding="8,3"
                                                    HorizontalOptions="Start" VerticalOptions="Start"
                                                    Margin="0,8,0,0">
                                                <Label Text="{Binding Trips}"
                                                       FontFamily="InterMedium" FontSize="11"
                                                       TextColor="White" />
                                            </Border>
                                            <VerticalStackLayout Grid.Row="2" Spacing="0">
                                                <Label Text="Başlangıç"
                                                       FontFamily="InterRegular" FontSize="10"
                                                       TextColor="White" Opacity="0.85" />
                                                <Label Text="{Binding Price}"
                                                       FontFamily="InterExtraBold" FontSize="23"
                                                       TextColor="White" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CarouselView.ItemTemplate>
                    </CarouselView>

                    <IndicatorView x:Name="PopularRoutesIndicator"
                                   IndicatorColor="{StaticResource BgSurfaceContainerHigh}"
                                   SelectedIndicatorColor="{StaticResource BgSecondary}"
                                   IndicatorSize="7"
                                   HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Güven Bandı -->
                <Border StrokeShape="RoundRectangle 12"
                        BackgroundColor="{StaticResource BgSurfaceContainerHigh}"
                        Padding="12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border Grid.Column="0"
                                WidthRequest="40" HeightRequest="40"
                                StrokeShape="RoundRectangle 20"
                                BackgroundColor="{StaticResource BgSurfaceContainerLowest}"
                                VerticalOptions="Center">
                            <Label Text="{StaticResource IconVerifiedUser}"
                                   FontFamily="MaterialSymbols" FontSize="20"
                                   TextColor="{StaticResource BgSecondary}"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="%100 Güvenli Ödeme &amp; İptal"
                                   FontFamily="InterSemiBold" FontSize="14"
                                   TextColor="{StaticResource BgOnSurface}" />
                            <Label Text="Kesintisiz iade güvencesi ve 7/24 canlı destek."
                                   FontFamily="InterRegular" FontSize="12"
                                   TextColor="{StaticResource BgOnSurfaceVariant}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ALT NAVBAR (DEĞİŞTİRİLMEDİ) -->
        <controls:BottomNavBar Grid.Row="2" ActiveTab="home" />
    </Grid>
</ContentPage>