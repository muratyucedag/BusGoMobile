<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:BusGoMobile.Controls"
             x:Class="BusGoMobile.Pages.HomePage"
             BackgroundColor="{StaticResource BgSurface}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ÜST BAR (Header) -->
        <Grid Grid.Row="0"
              BackgroundColor="{StaticResource BgSurface}"
              Padding="16,12"
              ColumnDefinitions="Auto,*,Auto,Auto"
              ColumnSpacing="12">

            <Border Grid.Column="0"
                    WidthRequest="32" HeightRequest="32"
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="{StaticResource BgSecondaryContainer}"
                    VerticalOptions="Center">
                <Label Text="{StaticResource IconBus}"
                       FontFamily="MaterialSymbols" FontSize="18"
                       TextColor="{StaticResource BgOnSecondary}"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0">
                <Label Text="BusGo"
                       FontFamily="InterBold" FontSize="17"
                       TextColor="{StaticResource BgOnSurface}" />
                <Label Text="Ana Sayfa"
                       FontFamily="InterRegular" FontSize="12"
                       TextColor="{StaticResource BgOnSurfaceVariant}" />
            </VerticalStackLayout>

            <Label Grid.Column="2"
                   Text="{StaticResource IconNotifications}"
                   FontFamily="MaterialSymbols" FontSize="22"
                   TextColor="{StaticResource BgOnSurfaceVariant}"
                   VerticalOptions="Center" />

            <Border Grid.Column="3"
                    WidthRequest="32" HeightRequest="32"
                    StrokeShape="RoundRectangle 16"
                    BackgroundColor="{StaticResource BgSurfaceContainerHighest}"
                    VerticalOptions="Center">
                <Label Text="{StaticResource IconPerson}"
                       FontFamily="MaterialSymbols" FontSize="18"
                       TextColor="{StaticResource BgOnSurfaceVariant}"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
        </Grid>

        <!-- KAYDIRILABİLİR İÇERİK -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,8,16,24" Spacing="20">

                <!-- Karşılama + Puan -->
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="Merhaba, Murat 👋"
                               FontFamily="InterRegular" FontSize="14"
                               TextColor="{StaticResource BgOnSurfaceVariant}" />
                        <Label Text="Bugün nereye gitmek istersin?"
                               FontFamily="InterBold" FontSize="24"
                               TextColor="{StaticResource BgOnSurface}" />
                    </VerticalStackLayout>

                    <Border Grid.Column="1"
                            StrokeShape="RoundRectangle 20"
                            BackgroundColor="{StaticResource BgSurfaceContainerHigh}"
                            Padding="10,6"
                            VerticalOptions="Start">
                        <HorizontalStackLayout Spacing="4">
                            <Label Text="{StaticResource IconStar}"
                                   FontFamily="MaterialSymbols" FontSize="14"
                                   TextColor="{StaticResource BgSecondary}"
                                   VerticalOptions="Center" />
                            <Label Text="120 Puan"
                                   FontFamily="InterBold" FontSize="11"
                                   TextColor="{StaticResource BgOnSurface}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>

                <!-- Ulaşım türü sekmeleri (veritabanından) -->
                <CollectionView x:Name="CategoriesView"
                                ItemsLayout="HorizontalList"
                                HeightRequest="52">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border StrokeShape="RoundRectangle 20"
                                    BackgroundColor="{StaticResource BgSurfaceContainerLowest}"
                                    Padding="14,10" Margin="0,0,8,0">
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="{Binding IconGlyph}"
                                           FontFamily="MaterialSymbols" FontSize="18"
                                           TextColor="{StaticResource BgOnSurfaceVariant}"
                                           VerticalOptions="Center" />
                                    <Label Text="{Binding Name}"
                                           FontFamily="InterRegular" FontSize="14"
                                           TextColor="{StaticResource BgOnSurfaceVariant}"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- KAMPANYA SLIDER (basit, veritabanından) -->
                <VerticalStackLayout Spacing="8">

                    <!-- Tek görsel gösteren alan -->
                    <Border StrokeShape="RoundRectangle 12"
                            StrokeThickness="0"
                            HeightRequest="150">
                        <Grid>
                            <Image x:Name="SlideImage"
                                   Aspect="AspectFill" />
                            <BoxView VerticalOptions="End"
                                     HeightRequest="80"
                                     Color="Black"
                                     Opacity="0.35" />
                            <VerticalStackLayout VerticalOptions="End"
                                                 Padding="14"
                                                 Spacing="2">
                                <Label x:Name="SlideTitle"
                                       FontFamily="InterBold" FontSize="17"
                                       TextColor="White" />
                                <Label x:Name="SlideSubtitle"
                                       FontFamily="InterRegular" FontSize="12"
                                       TextColor="White" />
                            </VerticalStackLayout>

                            <!-- Dokununca elle geçiş için -->
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSlideTapped" />
                            </Grid.GestureRecognizers>
                        </Grid>
                    </Border>

                    <!-- Noktalar -->
                    <HorizontalStackLayout x:Name="DotsContainer"
                                           Spacing="6"
                                           HorizontalOptions="Center" />

                </VerticalStackLayout>

                <!-- Popüler Firmalar -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="POPÜLER FİRMALAR"
                           FontFamily="InterBold" FontSize="11"
                           TextColor="{StaticResource BgOnSurfaceVariant}" />
                    <ScrollView Orientation="Horizontal"
                                HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout Spacing="8">
                            <Border StrokeShape="RoundRectangle 20"
                                    BackgroundColor="{StaticResource BgSurfaceContainerLowest}"
                                    Padding="14,6">
                                <HorizontalStackLayout Spacing="4">
                                    <Label Text="{StaticResource IconVerified}"
                                           FontFamily="MaterialSymbols" FontSize="15"
                                           TextColor="{StaticResource BgSecondary}"
                                           VerticalOptions="Center" />
                                    <Label Text="Kamil Koç" FontFamily="InterMedium" FontSize="12"
                                           TextColor="{StaticResource BgOnSurface}"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                            <Border StrokeShape="RoundRectangle 20"
                                    BackgroundColor="{StaticResource BgSurfaceContainerLowest}"
                                    Padding="14,6">
                                <HorizontalStackLayout Spacing="4">
                                    <Label Text="{StaticResource IconVerified}"
                                           FontFamily="MaterialSymbols" FontSize="15"
                                           TextColor="{StaticResource BgSecondary}"
                                           VerticalOptions="Center" />
                                    <Label Text="Pamukkale" FontFamily="InterMedium" FontSize="12"
                                           TextColor="{StaticResource BgOnSurface}"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                            <Border StrokeShape="RoundRectangle 20"
                                    BackgroundColor="{StaticResource BgSurfaceContainerLowest}"
                                    Padding="14,6">
                                <HorizontalStackLayout Spacing="4">
                                    <Label Text="{StaticResource IconVerified}"
                                           FontFamily="MaterialSymbols" FontSize="15"
                                           TextColor="{StaticResource BgSecondary}"
                                           VerticalOptions="Center" />
                                    <Label Text="Metro Turizm" FontFamily="InterMedium" FontSize="12"
                                           TextColor="{StaticResource BgOnSurface}"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                            <Border StrokeShape="RoundRectangle 20"
                                    BackgroundColor="{StaticResource BgSurfaceContainerLowest}"
                                    Padding="14,6">
                                <HorizontalStackLayout Spacing="4">
                                    <Label Text="{StaticResource IconVerified}"
                                           FontFamily="MaterialSymbols" FontSize="15"
                                           TextColor="{StaticResource BgSecondary}"
                                           VerticalOptions="Center" />
                                    <Label Text="Varan" FontFamily="InterMedium" FontSize="12"
                                           TextColor="{StaticResource BgOnSurface}"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                        </HorizontalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>

                <!-- Popüler Rotalar (yatay, premium kartlar) -->
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Popüler Rotalar"
                               FontFamily="InterBold" FontSize="17"
                               TextColor="{StaticResource BgOnSurface}" />
                        <Label Grid.Column="1" Text="Tümünü Gör"
                               FontFamily="InterMedium" FontSize="12"
                               TextColor="{StaticResource BgSecondary}"
                               VerticalOptions="Center" />
                    </Grid>

                    <ScrollView Orientation="Horizontal"
                                HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout Spacing="12">

                            <!-- Kart 1 -->
                            <Border StrokeShape="RoundRectangle 16"
                                    StrokeThickness="0"
                                    WidthRequest="200" HeightRequest="150"
                                    Padding="0">
                                <Grid>
                                    <Border StrokeShape="RoundRectangle 16" StrokeThickness="0">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="{StaticResource BgSecondaryContainer}" Offset="0.0" />
                                                <GradientStop Color="{StaticResource BgSecondary}" Offset="1.0" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Ellipse WidthRequest="120" HeightRequest="120"
                                             Fill="White" Opacity="0.08"
                                             HorizontalOptions="End" VerticalOptions="Start"
                                             Margin="0,-40,-40,0" />
                                    <Grid Padding="14" RowDefinitions="Auto,*,Auto">
                                        <Label Grid.Row="0" Text="İstanbul → Ankara"
                                               FontFamily="InterBold" FontSize="16"
                                               TextColor="White" />
                                        <Border Grid.Row="1"
                                                StrokeShape="RoundRectangle 10"
                                                BackgroundColor="#33FFFFFF"
                                                Padding="8,3"
                                                HorizontalOptions="Start" VerticalOptions="Start"
                                                Margin="0,8,0,0">
                                            <Label Text="Günlük 48 sefer"
                                                   FontFamily="InterMedium" FontSize="11"
                                                   TextColor="White" />
                                        </Border>
                                        <VerticalStackLayout Grid.Row="2" Spacing="0">
                                            <Label Text="Başlangıç"
                                                   FontFamily="InterRegular" FontSize="10"
                                                   TextColor="White" Opacity="0.85" />
                                            <Label Text="450 TL"
                                                   FontFamily="InterExtraBold" FontSize="22"
                                                   TextColor="White" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Kart 2 -->
                            <Border StrokeShape="RoundRectangle 16"
                                    StrokeThickness="0"
                                    WidthRequest="200" HeightRequest="150"
                                    Padding="0">
                                <Grid>
                                    <Border StrokeShape="RoundRectangle 16" StrokeThickness="0">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="{StaticResource BgPrimary}" Offset="0.0" />
                                                <GradientStop Color="{StaticResource BgInverseSurface}" Offset="1.0" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Ellipse WidthRequest="120" HeightRequest="120"
                                             Fill="White" Opacity="0.06"
                                             HorizontalOptions="End" VerticalOptions="Start"
                                             Margin="0,-40,-40,0" />
                                    <Grid Padding="14" RowDefinitions="Auto,*,Auto">
                                        <Label Grid.Row="0" Text="İzmir → İstanbul"
                                               FontFamily="InterBold" FontSize="16"
                                               TextColor="White" />
                                        <Border Grid.Row="1"
                                                StrokeShape="RoundRectangle 10"
                                                BackgroundColor="#33FFFFFF"
                                                Padding="8,3"
                                                HorizontalOptions="Start" VerticalOptions="Start"
                                                Margin="0,8,0,0">
                                            <Label Text="Günlük 36 sefer"
                                                   FontFamily="InterMedium" FontSize="11"
                                                   TextColor="White" />
                                        </Border>
                                        <VerticalStackLayout Grid.Row="2" Spacing="0">
                                            <Label Text="Başlangıç"
                                                   FontFamily="InterRegular" FontSize="10"
                                                   TextColor="White" Opacity="0.85" />
                                            <Label Text="550 TL"
                                                   FontFamily="InterExtraBold" FontSize="22"
                                                   TextColor="White" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Kart 3 -->
                            <Border StrokeShape="RoundRectangle 16"
                                    StrokeThickness="0"
                                    WidthRequest="200" HeightRequest="150"
                                    Padding="0">
                                <Grid>
                                    <Border StrokeShape="RoundRectangle 16" StrokeThickness="0">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="{StaticResource BgSecondaryContainer}" Offset="0.0" />
                                                <GradientStop Color="{StaticResource BgSecondary}" Offset="1.0" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Ellipse WidthRequest="120" HeightRequest="120"
                                             Fill="White" Opacity="0.08"
                                             HorizontalOptions="End" VerticalOptions="Start"
                                             Margin="0,-40,-40,0" />
                                    <Grid Padding="14" RowDefinitions="Auto,*,Auto">
                                        <Label Grid.Row="0" Text="Bursa → Antalya"
                                               FontFamily="InterBold" FontSize="16"
                                               TextColor="White" />
                                        <Border Grid.Row="1"
                                                StrokeShape="RoundRectangle 10"
                                                BackgroundColor="#33FFFFFF"
                                                Padding="8,3"
                                                HorizontalOptions="Start" VerticalOptions="Start"
                                                Margin="0,8,0,0">
                                            <Label Text="Günlük 22 sefer"
                                                   FontFamily="InterMedium" FontSize="11"
                                                   TextColor="White" />
                                        </Border>
                                        <VerticalStackLayout Grid.Row="2" Spacing="0">
                                            <Label Text="Başlangıç"
                                                   FontFamily="InterRegular" FontSize="10"
                                                   TextColor="White" Opacity="0.85" />
                                            <Label Text="620 TL"
                                                   FontFamily="InterExtraBold" FontSize="22"
                                                   TextColor="White" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Kart 4 -->
                            <Border StrokeShape="RoundRectangle 16"
                                    StrokeThickness="0"
                                    WidthRequest="200" HeightRequest="150"
                                    Padding="0">
                                <Grid>
                                    <Border StrokeShape="RoundRectangle 16" StrokeThickness="0">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="{StaticResource BgPrimary}" Offset="0.0" />
                                                <GradientStop Color="{StaticResource BgInverseSurface}" Offset="1.0" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Ellipse WidthRequest="120" HeightRequest="120"
                                             Fill="White" Opacity="0.06"
                                             HorizontalOptions="End" VerticalOptions="Start"
                                             Margin="0,-40,-40,0" />
                                    <Grid Padding="14" RowDefinitions="Auto,*,Auto">
                                        <Label Grid.Row="0" Text="Ankara → Eskişehir"
                                               FontFamily="InterBold" FontSize="16"
                                               TextColor="White" />
                                        <Border Grid.Row="1"
                                                StrokeShape="RoundRectangle 10"
                                                BackgroundColor="#33FFFFFF"
                                                Padding="8,3"
                                                HorizontalOptions="Start" VerticalOptions="Start"
                                                Margin="0,8,0,0">
                                            <Label Text="Günlük 54 sefer"
                                                   FontFamily="InterMedium" FontSize="11"
                                                   TextColor="White" />
                                        </Border>
                                        <VerticalStackLayout Grid.Row="2" Spacing="0">
                                            <Label Text="Başlangıç"
                                                   FontFamily="InterRegular" FontSize="10"
                                                   TextColor="White" Opacity="0.85" />
                                            <Label Text="180 TL"
                                                   FontFamily="InterExtraBold" FontSize="22"
                                                   TextColor="White" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Grid>
                            </Border>

                        </HorizontalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>

                <!-- Güven Bandı -->
                <Border StrokeShape="RoundRectangle 12"
                        BackgroundColor="{StaticResource BgSurfaceContainerHigh}"
                        Padding="12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border Grid.Column="0"
                                WidthRequest="40" HeightRequest="40"
                                StrokeShape="RoundRectangle 20"
                                BackgroundColor="{StaticResource BgSurfaceContainerLowest}"
                                VerticalOptions="Center">
                            <Label Text="{StaticResource IconVerifiedUser}"
                                   FontFamily="MaterialSymbols" FontSize="20"
                                   TextColor="{StaticResource BgSecondary}"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="%100 Güvenli Ödeme &amp; İptal"
                                   FontFamily="InterSemiBold" FontSize="14"
                                   TextColor="{StaticResource BgOnSurface}" />
                            <Label Text="Kesintisiz iade güvencesi ve 7/24 canlı destek."
                                   FontFamily="InterRegular" FontSize="12"
                                   TextColor="{StaticResource BgOnSurfaceVariant}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ALT NAVBAR -->
        <controls:BottomNavBar Grid.Row="2" ActiveTab="home" />
    </Grid>
</ContentPage>