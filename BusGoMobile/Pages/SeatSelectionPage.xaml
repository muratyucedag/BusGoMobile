<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BusGoMobile.Pages.SeatSelectionPage"
             BackgroundColor="{StaticResource BgSurface}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ÜST BAR -->
        <Grid Grid.Row="0"
              BackgroundColor="{StaticResource BgSurface}"
              Padding="8,12"
              ColumnDefinitions="Auto,*"
              ColumnSpacing="8">
            <Label Grid.Column="0"
                   Text="‹" FontSize="28"
                   TextColor="{StaticResource BgOnSurface}"
                   VerticalOptions="Center"
                   WidthRequest="40"
                   HorizontalTextAlignment="Center" />
            <Label Grid.Column="1"
                   Text="Koltuk Seçimi"
                   FontFamily="InterBold" FontSize="17"
                   TextColor="{StaticResource BgOnSurface}"
                   VerticalOptions="Center" />
        </Grid>

        <!-- İÇERİK -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,4,16,16" Spacing="12">

                <!-- Sefer özeti kartı -->
                <Border StrokeShape="RoundRectangle 12"
                        BackgroundColor="{StaticResource BgSurfaceContainerLowest}"
                        Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <HorizontalStackLayout Grid.Column="0" Spacing="6">
                                <Border StrokeShape="RoundRectangle 10"
                                        BackgroundColor="{StaticResource BgSecondaryContainer}"
                                        Padding="8,3">
                                    <Label x:Name="CompanyLabel"
                                           Text="Pamukkale Turizm"
                                           FontFamily="InterBold" FontSize="11"
                                           TextColor="{StaticResource BgOnSecondary}" />
                                </Border>
                                <Border StrokeShape="RoundRectangle 10"
                                        BackgroundColor="{StaticResource BgSurfaceContainer}"
                                        Padding="8,3">
                                    <Label Text="2+1 Relax"
                                           FontFamily="InterMedium" FontSize="11"
                                           TextColor="{StaticResource BgOnSurfaceVariant}" />
                                </Border>
                            </HorizontalStackLayout>

                            <HorizontalStackLayout Grid.Column="1" Spacing="6">
                                <Label Text="{StaticResource IconWifi}"
                                       FontFamily="MaterialSymbols" FontSize="16"
                                       TextColor="{StaticResource BgSecondary}" />
                                <Label Text="{StaticResource IconPower}"
                                       FontFamily="MaterialSymbols" FontSize="16"
                                       TextColor="{StaticResource BgSecondary}" />
                                <Label Text="{StaticResource IconTv}"
                                       FontFamily="MaterialSymbols" FontSize="16"
                                       TextColor="{StaticResource BgSecondary}" />
                            </HorizontalStackLayout>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="İstanbul" FontFamily="InterBold" FontSize="17"
                                           TextColor="{StaticResource BgOnSurface}" />
                                    <Label Text="→" FontSize="16"
                                           TextColor="{StaticResource BgSecondary}"
                                           VerticalOptions="Center" />
                                    <Label Text="Ankara" FontFamily="InterBold" FontSize="17"
                                           TextColor="{StaticResource BgOnSurface}" />
                                </HorizontalStackLayout>
                                <Label Text="Esenler Otogarı → AŞTİ Terminali"
                                       FontFamily="InterRegular" FontSize="12"
                                       TextColor="{StaticResource BgOnSurfaceVariant}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" HorizontalOptions="End">
                                <Label Text="08:30" FontFamily="InterBold" FontSize="19"
                                       TextColor="{StaticResource BgOnSurface}"
                                       HorizontalOptions="End" />
                                <Label Text="18 Ekim Cuma" FontFamily="InterRegular" FontSize="12"
                                       TextColor="{StaticResource BgOnSurfaceVariant}"
                                       HorizontalOptions="End" />
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Ayırıcı çizgi -->
                        <BoxView HeightRequest="1"
                                 Color="{StaticResource BgOutlineVariant}" />

                        <!-- Kalan boş koltuk -->
                        <Grid ColumnDefinitions="Auto,*">
                            <Label Grid.Column="0"
                                   Text="{StaticResource IconChair}"
                                   FontFamily="MaterialSymbols" FontSize="16"
                                   TextColor="{StaticResource BgSecondary}"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   x:Name="RemainingSeatsLabel"
                                   Text=""
                                   FontFamily="InterMedium" FontSize="12"
                                   TextColor="{StaticResource BgSecondary}"
                                   VerticalOptions="Center"
                                   Margin="6,0,0,0" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Açıklama (legend) -->
                <Border StrokeShape="RoundRectangle 12"
                        BackgroundColor="{StaticResource BgSurfaceContainerLow}"
                        Padding="12,10">
                    <Grid ColumnDefinitions="*,*,*,*">
                        <VerticalStackLayout Grid.Column="0" Spacing="4" HorizontalOptions="Center">
                            <Border WidthRequest="28" HeightRequest="28"
                                    StrokeShape="RoundRectangle 8"
                                    BackgroundColor="{StaticResource BgSurfaceContainerLowest}"
                                    Stroke="{StaticResource BgOutlineVariant}" StrokeThickness="1" />
                            <Label Text="Boş" FontFamily="InterMedium" FontSize="11"
                                   TextColor="{StaticResource BgOnSurfaceVariant}"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="4" HorizontalOptions="Center">
                            <Border WidthRequest="28" HeightRequest="28"
                                    StrokeShape="RoundRectangle 8"
                                    BackgroundColor="{StaticResource BgSecondaryContainer}" />
                            <Label Text="Seçili" FontFamily="InterBold" FontSize="11"
                                   TextColor="{StaticResource BgSecondary}"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="2" Spacing="4" HorizontalOptions="Center">
                            <Border WidthRequest="28" HeightRequest="28"
                                    StrokeShape="RoundRectangle 8"
                                    BackgroundColor="{StaticResource BgSurfaceContainerHighest}">
                                <Label Text="{StaticResource IconMan}"
                                       FontFamily="MaterialSymbols" FontSize="15"
                                       TextColor="{StaticResource BgPrimary}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Text="Dolu (E)" FontFamily="InterMedium" FontSize="11"
                                   TextColor="{StaticResource BgOnSurfaceVariant}"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="3" Spacing="4" HorizontalOptions="Center">
                            <Border WidthRequest="28" HeightRequest="28"
                                    StrokeShape="RoundRectangle 8"
                                    BackgroundColor="{StaticResource BgErrorContainer}">
                                <Label Text="{StaticResource IconWoman}"
                                       FontFamily="MaterialSymbols" FontSize="15"
                                       TextColor="{StaticResource BgError}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Text="Dolu (K)" FontFamily="InterMedium" FontSize="11"
                                   TextColor="{StaticResource BgOnSurfaceVariant}"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Otobüs gövdesi -->
                <Border StrokeShape="RoundRectangle 16"
                        BackgroundColor="{StaticResource BgSurfaceContainerLowest}"
                        Padding="16">
                    <VerticalStackLayout Spacing="12">

                        <!-- Şoför / ön bölüm -->
                        <Border StrokeShape="RoundRectangle 10"
                                BackgroundColor="{StaticResource BgSurfaceContainerLow}"
                                Padding="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <HorizontalStackLayout Grid.Column="0" Spacing="8">
                                    <Border WidthRequest="36" HeightRequest="36"
                                            StrokeShape="RoundRectangle 18"
                                            BackgroundColor="{StaticResource BgSurfaceContainerHigh}">
                                        <Label Text="{StaticResource IconMeetingRoom}"
                                               FontFamily="MaterialSymbols" FontSize="18"
                                               TextColor="{StaticResource BgOnSurfaceVariant}"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout VerticalOptions="Center" Spacing="0">
                                        <Label Text="KAPTAN" FontFamily="InterBold" FontSize="11"
                                               TextColor="{StaticResource BgOnSurfaceVariant}" />
                                        <Label Text="Şoför Alanı" FontFamily="InterMedium" FontSize="12"
                                               TextColor="{StaticResource BgOnSurface}" />
                                    </VerticalStackLayout>
                                </HorizontalStackLayout>
                                <Label Grid.Column="1" Text="Otobüs Önü"
                                       FontFamily="InterMedium" FontSize="11"
                                       TextColor="{StaticResource BgOnSurfaceVariant}"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <!-- KOLTUKLAR buraya kod tarafında eklenecek -->
                        <VerticalStackLayout x:Name="SeatsContainer" Spacing="10" />

                    </VerticalStackLayout>
                </Border>

                <!-- Cinsiyet güvencesi -->
                <Border StrokeShape="RoundRectangle 12"
                        BackgroundColor="{StaticResource BgSurfaceContainerHigh}"
                        Padding="12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Border Grid.Column="0"
                                WidthRequest="36" HeightRequest="36"
                                StrokeShape="RoundRectangle 18"
                                BackgroundColor="{StaticResource BgSurfaceContainerLowest}"
                                VerticalOptions="Center">
                            <Label Text="{StaticResource IconShieldPerson}"
                                   FontFamily="MaterialSymbols" FontSize="18"
                                   TextColor="{StaticResource BgSecondary}"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Cinsiyet Kuralları Güvencesi"
                                   FontFamily="InterSemiBold" FontSize="14"
                                   TextColor="{StaticResource BgOnSurface}" />
                            <Label Text="Yan yana çift koltuklarda aynı cinsiyet kuralı uygulanır."
                                   FontFamily="InterRegular" FontSize="12"
                                   TextColor="{StaticResource BgOnSurfaceVariant}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ALT ÖZET ÇUBUĞU -->
        <Border Grid.Row="2"
                BackgroundColor="{StaticResource BgSurfaceContainerLowest}"
                StrokeThickness="0"
                Padding="16,10">
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                    <Label x:Name="SelectedSeatLabel"
                           Text="Koltuk Seçiniz"
                           FontFamily="InterSemiBold" FontSize="14"
                           TextColor="{StaticResource BgSecondary}" />
                    <HorizontalStackLayout Spacing="4">
                        <Label Text="TOPLAM" FontFamily="InterBold" FontSize="10"
                               TextColor="{StaticResource BgOnSurfaceVariant}"
                               VerticalOptions="Center" />
                        <Label x:Name="TotalPriceLabel"
                               Text="0 TL"
                               FontFamily="InterExtraBold" FontSize="20"
                               TextColor="{StaticResource BgOnSurface}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <Button x:Name="ProceedButton"
                        Grid.Column="1"
                        Text="Devam Et  ›"
                        FontFamily="InterBold" FontSize="16"
                        HeightRequest="48"
                        Padding="20,0"
                        BackgroundColor="{StaticResource BgSecondaryContainer}"
                        TextColor="{StaticResource BgOnSecondary}"
                        CornerRadius="12"
                        Clicked="OnProceedClicked" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>