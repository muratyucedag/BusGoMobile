<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BusGoMobile.Pages.TripListPage"
             BackgroundColor="{StaticResource BgSurface}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- ÜST BAR -->
        <Grid Grid.Row="0"
              BackgroundColor="{StaticResource BgSurface}"
              Padding="8,12"
              ColumnDefinitions="Auto,Auto,*,Auto"
              ColumnSpacing="8">

            <Label Grid.Column="0"
                   Text="‹" FontSize="28"
                   TextColor="{StaticResource BgOnSurface}"
                   VerticalOptions="Center"
                   WidthRequest="32"
                   HorizontalTextAlignment="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Label.GestureRecognizers>
            </Label>

            <Border Grid.Column="1"
                    WidthRequest="32" HeightRequest="32"
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="{StaticResource BgSecondaryContainer}"
                    VerticalOptions="Center">
                <Label Text="{StaticResource IconBus}"
                       FontFamily="MaterialSymbols" FontSize="18"
                       TextColor="{StaticResource BgOnSecondary}"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

            <Label Grid.Column="2"
                   Text="Sefer Listesi"
                   FontFamily="InterBold" FontSize="17"
                   TextColor="{StaticResource BgOnSurface}"
                   VerticalOptions="Center" />

            <Border Grid.Column="3"
                    WidthRequest="32" HeightRequest="32"
                    StrokeShape="RoundRectangle 16"
                    BackgroundColor="{StaticResource BgSurfaceContainerHighest}"
                    VerticalOptions="Center">
                <Label Text="{StaticResource IconPerson}"
                       FontFamily="MaterialSymbols" FontSize="18"
                       TextColor="{StaticResource BgOnSurfaceVariant}"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
        </Grid>

        <!-- SABİT BAŞLIK: Rota özeti + tarih + filtreler -->
        <VerticalStackLayout Grid.Row="1"
                             BackgroundColor="{StaticResource BgSurface}"
                             Padding="16,4,16,8"
                             Spacing="8">

            <!-- Rota özeti -->
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label x:Name="RouteLabel"
                           Text="İstanbul → Ankara"
                           FontFamily="InterBold" FontSize="17"
                           TextColor="{StaticResource BgOnSurface}" />
                    <Label x:Name="RouteSubLabel"
                           Text="18 Ekim 2024, Cuma  •  1 Yolcu"
                           FontFamily="InterRegular" FontSize="12"
                           TextColor="{StaticResource BgOnSurfaceVariant}" />
                </VerticalStackLayout>

                <Border Grid.Column="1"
                        StrokeShape="RoundRectangle 8"
                        BackgroundColor="{StaticResource BgSurfaceContainer}"
                        Padding="10,6"
                        VerticalOptions="Center">
                    <HorizontalStackLayout Spacing="4">
                        <Label Text="{StaticResource IconEditCalendar}"
                               FontFamily="MaterialSymbols" FontSize="14"
                               TextColor="{StaticResource BgOnSurface}"
                               VerticalOptions="Center" />
                        <Label Text="Değiştir"
                               FontFamily="InterMedium" FontSize="12"
                               TextColor="{StaticResource BgOnSurface}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>

            <!-- Tarih seçici (3 gün) -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Border Grid.Column="0"
                        StrokeShape="RoundRectangle 8"
                        BackgroundColor="{StaticResource BgSurfaceContainerLowest}"
                        Padding="0,6">
                    <VerticalStackLayout Spacing="0" HorizontalOptions="Center">
                        <Label Text="17 Eki Per" FontFamily="InterRegular" FontSize="12"
                               HorizontalOptions="Center"
                               TextColor="{StaticResource BgOnSurfaceVariant}" />
                        <Label Text="Dün" FontFamily="InterRegular" FontSize="11"
                               HorizontalOptions="Center"
                               TextColor="{StaticResource BgOutline}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1"
                        StrokeShape="RoundRectangle 8"
                        BackgroundColor="{StaticResource BgPrimary}"
                        Padding="0,6">
                    <VerticalStackLayout Spacing="0" HorizontalOptions="Center">
                        <Label Text="18 Eki Cum" FontFamily="InterBold" FontSize="14"
                               HorizontalOptions="Center"
                               TextColor="{StaticResource BgOnPrimary}" />
                        <Label Text="Bugün (Seçili)" FontFamily="InterRegular" FontSize="11"
                               HorizontalOptions="Center"
                               TextColor="{StaticResource BgSecondaryFixedDim}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="2"
                        StrokeShape="RoundRectangle 8"
                        BackgroundColor="{StaticResource BgSurfaceContainerLowest}"
                        Padding="0,6">
                    <VerticalStackLayout Spacing="0" HorizontalOptions="Center">
                        <Label Text="19 Eki Cmt" FontFamily="InterRegular" FontSize="12"
                               HorizontalOptions="Center"
                               TextColor="{StaticResource BgOnSurfaceVariant}" />
                        <Label Text="Yarın" FontFamily="InterRegular" FontSize="11"
                               HorizontalOptions="Center"
                               TextColor="{StaticResource BgOutline}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Filtre şeridi -->
            <ScrollView Orientation="Horizontal"
                        HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="8">
                    <Border StrokeShape="RoundRectangle 16"
                            BackgroundColor="{StaticResource BgSurfaceContainerLowest}"
                            Padding="14,6">
                        <HorizontalStackLayout Spacing="4">
                            <Label Text="{StaticResource IconTune}"
                                   FontFamily="MaterialSymbols" FontSize="14"
                                   TextColor="{StaticResource BgSecondary}"
                                   VerticalOptions="Center" />
                            <Label Text="Filtrele" FontFamily="InterMedium" FontSize="12"
                                   TextColor="{StaticResource BgOnSurface}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>

                    <Border StrokeShape="RoundRectangle 16"
                            BackgroundColor="{StaticResource BgPrimary}"
                            Padding="14,6">
                        <HorizontalStackLayout Spacing="4">
                            <Label Text="{StaticResource IconArrowDownward}"
                                   FontFamily="MaterialSymbols" FontSize="14"
                                   TextColor="{StaticResource BgOnPrimary}"
                                   VerticalOptions="Center" />
                            <Label Text="En Ucuz" FontFamily="InterMedium" FontSize="12"
                                   TextColor="{StaticResource BgOnPrimary}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>

                    <Border StrokeShape="RoundRectangle 16"
                            BackgroundColor="{StaticResource BgSurfaceContainerLowest}"
                            Padding="14,6">
                        <HorizontalStackLayout Spacing="4">
                            <Label Text="{StaticResource IconSchedule}"
                                   FontFamily="MaterialSymbols" FontSize="14"
                                   TextColor="{StaticResource BgOnSurfaceVariant}"
                                   VerticalOptions="Center" />
                            <Label Text="Kalkış Saati" FontFamily="InterMedium" FontSize="12"
                                   TextColor="{StaticResource BgOnSurface}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>

                    <Border StrokeShape="RoundRectangle 16"
                            BackgroundColor="{StaticResource BgSurfaceContainerLowest}"
                            Padding="14,6">
                        <HorizontalStackLayout Spacing="4">
                            <Label Text="{StaticResource IconBus}"
                                   FontFamily="MaterialSymbols" FontSize="14"
                                   TextColor="{StaticResource BgOnSurfaceVariant}"
                                   VerticalOptions="Center" />
                            <Label Text="Firma" FontFamily="InterMedium" FontSize="12"
                                   TextColor="{StaticResource BgOnSurface}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </HorizontalStackLayout>
            </ScrollView>
        </VerticalStackLayout>

        <!-- SEFER LİSTESİ (dinamik) -->
        <ScrollView Grid.Row="2">
            <VerticalStackLayout Padding="16,8,16,24" Spacing="8">

                <!-- Sonuç sayısı -->
                <Grid ColumnDefinitions="*,Auto">
                    <Label x:Name="ResultCountLabel"
                           Grid.Column="0"
                           Text="Seferler yükleniyor..."
                           FontFamily="InterRegular" FontSize="12"
                           TextColor="{StaticResource BgOnSurfaceVariant}"
                           VerticalOptions="Center" />
                    <HorizontalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="{StaticResource IconVerifiedUser}"
                               FontFamily="MaterialSymbols" FontSize="14"
                               TextColor="{StaticResource BgSecondary}"
                               VerticalOptions="Center" />
                        <Label Text="Güvenli Rezervasyon"
                               FontFamily="InterMedium" FontSize="12"
                               TextColor="{StaticResource BgSecondary}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Grid>

                <!-- Sefer kartları -->
                <CollectionView x:Name="TripsView"
                                SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{StaticResource BgSurfaceContainerLowest}"
                                    Padding="12">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnTripTapped"
                                                          CommandParameter="{Binding Id}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="8">

                                    <!-- Firma satırı + olanak ikonları -->
                                    <Grid ColumnDefinitions="Auto,Auto,*">
                                        <Border Grid.Column="0"
                                                StrokeShape="RoundRectangle 4"
                                                BackgroundColor="{Binding CompanyColorAsColor}"
                                                Padding="8,4" VerticalOptions="Center">
                                            <Label Text="{Binding CompanyName}"
                                                   FontFamily="InterBold" FontSize="12"
                                                   TextColor="White" />
                                        </Border>
                                        <Border Grid.Column="1"
                                                StrokeShape="RoundRectangle 4"
                                                BackgroundColor="{StaticResource BgSurfaceContainer}"
                                                Padding="6,4" Margin="6,0,0,0"
                                                VerticalOptions="Center">
                                            <Label Text="{Binding SeatLayout}"
                                                   FontFamily="InterMedium" FontSize="11"
                                                   TextColor="{StaticResource BgOnSurfaceVariant}" />
                                        </Border>

                                        <!-- Olanak ikonları (dinamik) -->
                                        <CollectionView Grid.Column="2"
                                                        ItemsSource="{Binding AmenityList}"
                                                        ItemsLayout="HorizontalList"
                                                        HorizontalOptions="End"
                                                        VerticalOptions="Center"
                                                        InputTransparent="True">
                                            <CollectionView.ItemTemplate>
                                                <DataTemplate>
                                                    <Label Text="{Binding IconGlyph}"
                                                           FontFamily="MaterialSymbols"
                                                           FontSize="18"
                                                           TextColor="{StaticResource BgOnSurfaceVariant}"
                                                           Margin="4,0,0,0"
                                                           VerticalOptions="Center" />
                                                </DataTemplate>
                                            </CollectionView.ItemTemplate>
                                        </CollectionView>
                                    </Grid>

                                    <!-- Zaman çizelgesi -->
                                    <Grid ColumnDefinitions="*,*,*">
                                        <VerticalStackLayout Grid.Column="0" Spacing="1">
                                            <Label Text="{Binding DepartTime}"
                                                   FontFamily="InterBold" FontSize="19"
                                                   TextColor="{StaticResource BgOnSurface}" />
                                            <Label Text="{Binding FromCity}"
                                                   FontFamily="InterSemiBold" FontSize="12"
                                                   TextColor="{StaticResource BgOnSurface}" />
                                            <Label Text="{Binding FromTerminal}"
                                                   FontFamily="InterRegular" FontSize="11"
                                                   TextColor="{StaticResource BgOnSurfaceVariant}" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Column="1" Spacing="2"
                                                             HorizontalOptions="Center">
                                            <Label Text="{Binding Duration}"
                                                   FontFamily="InterRegular" FontSize="11"
                                                   HorizontalOptions="Center"
                                                   TextColor="{StaticResource BgOnSurfaceVariant}" />
                                            <BoxView HeightRequest="2" WidthRequest="60"
                                                     Color="{StaticResource BgSurfaceContainerHighest}"
                                                     VerticalOptions="Center" />
                                            <Label Text="{Binding RouteNote}"
                                                   FontFamily="InterRegular" FontSize="10"
                                                   HorizontalOptions="Center"
                                                   TextColor="{StaticResource BgOutline}" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Column="2" Spacing="1"
                                                             HorizontalOptions="End">
                                            <Label Text="{Binding ArriveTime}"
                                                   FontFamily="InterBold" FontSize="19"
                                                   TextColor="{StaticResource BgOnSurface}"
                                                   HorizontalOptions="End" />
                                            <Label Text="{Binding ToCity}"
                                                   FontFamily="InterSemiBold" FontSize="12"
                                                   TextColor="{StaticResource BgOnSurface}"
                                                   HorizontalOptions="End" />
                                            <Label Text="{Binding ToTerminal}"
                                                   FontFamily="InterRegular" FontSize="11"
                                                   TextColor="{StaticResource BgOnSurfaceVariant}"
                                                   HorizontalOptions="End" />
                                        </VerticalStackLayout>
                                    </Grid>

                                    <!-- Fiyat + buton -->
                                    <Border StrokeShape="RoundRectangle 8"
                                            BackgroundColor="{StaticResource BgSurfaceContainerLow}"
                                            Padding="10,8">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                <Label Text="{Binding SeatInfo}"
                                                       FontFamily="InterMedium" FontSize="11"
                                                       TextColor="{StaticResource BgSecondary}" />
                                                <Label Text="{Binding PriceText}"
                                                       FontFamily="InterExtraBold" FontSize="22"
                                                       TextColor="{StaticResource BgOnSurface}" />
                                            </VerticalStackLayout>

                                            <Border Grid.Column="1"
                                                    StrokeShape="RoundRectangle 8"
                                                    BackgroundColor="{StaticResource BgSecondary}"
                                                    Padding="16,10" VerticalOptions="Center">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnTripTapped"
                                                                          CommandParameter="{Binding Id}" />
                                                </Border.GestureRecognizers>
                                                <HorizontalStackLayout Spacing="2">
                                                    <Label Text="Koltuk Seç"
                                                           FontFamily="InterBold" FontSize="15"
                                                           TextColor="{StaticResource BgOnSecondary}"
                                                           VerticalOptions="Center" />
                                                    <Label Text="{StaticResource IconChevronRight}"
                                                           FontFamily="MaterialSymbols" FontSize="16"
                                                           TextColor="{StaticResource BgOnSecondary}"
                                                           VerticalOptions="Center" />
                                                </HorizontalStackLayout>
                                            </Border>
                                        </Grid>
                                    </Border>

                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>